# Campaign TOW — Environment Variables
# Copy this file to .env for local development.
# NEVER commit local environment files to the repository.

# PostgreSQL settings used by docker-compose.prod.yml
POSTGRES_USER=campaign_tow
POSTGRES_PASSWORD=
POSTGRES_DB=campaign_tow_prod

# Public IPv4 address that Traefik should bind on in production.
# Set this in .env, not in this example file.
VPS_BIND_IP=

# PostgreSQL connection string
# Local dev (Docker): postgresql://campaign_tow:dev_password@localhost:5432/campaign_tow_dev
# Production Docker: built by docker-compose.prod.yml from POSTGRES_* variables
DATABASE_URL=

# Session encryption secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# Admin account username
ADMIN_USERNAME=admin

# Bcrypt hash of admin password (12 rounds), consumed by `pnpm seed:admin`
ADMIN_PASSWORD_HASH=

PLAYWRIGHT_BASE_URL=

# Sentry — DSN public (safe à exposer dans le bundle browser)
# Format : https://<key>@<host>/<projectId>
# Le tunnel serveur dérive host + projectId à partir de SENTRY_DSN.
# VITE_SENTRY_DSN est exposé au bundle client (préfixe VITE_ obligatoire).
SENTRY_DSN=
VITE_SENTRY_DSN=

# Sentry auth token — pour upload des sourcemaps au build (NE PAS exposer)
SENTRY_AUTH_TOKEN=
