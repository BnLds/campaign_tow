# Campaign TOW — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to the repository.

# PostgreSQL connection string
# Local dev (Docker): postgresql://campaign_tow:dev_password@localhost:5432/campaign_tow_dev
# Production: from Railway PostgreSQL plugin dashboard
DATABASE_URL=

# Session encryption secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# Admin account username
ADMIN_USERNAME=admin

# Bcrypt hash of admin password (12 rounds) — set in Railway dashboard only
ADMIN_PASSWORD_HASH=

PLAYWRIGHT_BASE_URL=
